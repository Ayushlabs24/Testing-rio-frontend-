NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_TIMEOUT_MS=15000
# Mock staff-OTP sign-in fallback (see src/services/auth/otp.mock.ts) — the
# real backend has no OTP-sign-in endpoint yet. Leave unset/false in every
# real deployment; only set "true" for local development or a dedicated
# test build that needs to exercise that UI flow without a backend.
# NEXT_PUBLIC_ENABLE_MOCK_AUTH=false
